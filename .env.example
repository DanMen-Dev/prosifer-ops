# Copiar a .env y cambiar los valores. .env nunca va al repo.
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
PROSIFER_API_KEY=cambiar-por-otra-clave-larga
PROSIFER_PUERTO=8110
PROSIFER_PUERTO_WEB=8111
# Firma de las sesiones. Si se deja vacío se deriva de PROSIFER_API_KEY.
# Cambiarlo cierra todas las sesiones abiertas.
PROSIFER_SECRETO=
# Orígenes permitidos para el frontend, separados por coma
# Demo pública:
# PROSIFER_CORS=https://demo-prosifer.brecha-cero.com
PROSIFER_CORS=
